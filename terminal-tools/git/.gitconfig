; Included from ~/.config/git/config, which chezmoi deploys from
; home/dot_config/git/config.tmpl with the machine/user specific settings
; (user.name/email, core.excludesfile). Keep only portable settings here.
[push]
    default = current
    autoSetupRemote = true
[pull]
    rebase = false
; Authenticate to GitHub over HTTPS with the gh token in the OS keyring
; instead of a private key file under ~/.ssh.
; Helpers from system config are not reset so that the one injected by
; VS Code Dev Containers keeps forwarding the host credential.
[credential "https://github.com"]
    helper = !gh auth git-credential
[credential "https://gist.github.com"]
    helper = !gh auth git-credential
[url "https://github.com/"]
    insteadOf = git@github.com:
    insteadOf = ssh://git@github.com/
