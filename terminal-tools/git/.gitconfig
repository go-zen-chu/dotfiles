; Machine/user specific settings (user.name/email, core.excludesfile,
; user.signingkey) are written to ~/.gitconfig by install.sh because they
; contain absolute paths. Keep only portable settings here.
[push]
    default = current
    autoSetupRemote = true
[pull]
    rebase = false
[gpg]
    format = ssh
[commit]
    gpgsign = true
